{
  "$schema": "https://registry.tabularis.dev/manifest.schema.json?kind=driver",
  "id": "jdbc-informix",
  "name": "Informix JDBC",
  "version": "0.1.0",
  "description": "IBM Informix database via JDBC",
  "default_port": 9088,
  "executable": "tabularis-jdbc",
  "connection_metadata": true,
  "capabilities": {
    "schemas": true,
    "views": true,
    "routines": false,
    "file_based": false,
    "identifier_quote": "\"",
    "alter_primary_key": false,
    "alter_column": false,
    "create_foreign_keys": false,
    "manage_tables": false,
    "readonly": false,
    "explain": false,
    "sql_dialect": "generic",
    "connection_string": true,
    "connection_string_example": "informix-sqli://localhost:9088/mydb"
  },
  "settings": [
    {
      "key": "driver_gav",
      "label": "Driver Maven coordinate override",
      "type": "string",
      "required": false,
      "description": "Override the default JDBC driver Maven coordinate"
    }
  ],
  "data_types": []
}
